{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.aicaptain.dev/security/v1/bundle-manifest.schema.json",
  "title": "Release bundle manifest",
  "description": "Signed manifest of an offline release archive. `securityctl verify-release` fails on any hash, signature or coverage mismatch. Contains no secrets by construction: the schema has no field that can carry one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "version", "platform", "createdAt", "files", "migrations", "compatibility", "sbom", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "security-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "platform": { "type": "string", "pattern": "^(windows|linux)-(amd64|arm64)$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "gitCommit": { "type": "string", "maxLength": 64 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sizeBytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$",
            "description": "Archive-relative, forward slashes, no .. segment, no absolute path, no drive letter, no backslash.",
            "maxLength": 512
          },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minSchemaVersion", "maxSchemaVersion", "migrations"],
      "properties": {
        "minSchemaVersion": { "type": "integer", "minimum": 1 },
        "maxSchemaVersion": { "type": "integer", "minimum": 1 },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "phase"],
            "properties": {
              "version": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "maxLength": 200 },
              "phase": {
                "enum": ["expand", "backfill", "contract"],
                "description": "Expand/contract only. A contract step may never be bundled with the expand step that makes it safe."
              }
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minCoreVersion", "maxCoreVersion", "contractsVersion"],
      "properties": {
        "minCoreVersion": { "type": "string" },
        "maxCoreVersion": { "type": "string" },
        "contractsVersion": { "type": "string" }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "format": { "enum": ["spdx-json", "spdx-tag-value", "cyclonedx-json"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builder": { "type": "string", "maxLength": 256 },
        "buildStartedAt": { "type": "string", "format": "date-time" },
        "buildFinishedAt": { "type": "string", "format": "date-time" },
        "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "attestations": { "type": "array", "items": { "type": "string", "maxLength": 512 }, "maxItems": 64 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value", "publicKey"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"] },
        "keyId": { "type": "string", "maxLength": 128 },
        "value": { "type": "string", "minLength": 1 },
        "publicKey": { "type": "string", "minLength": 1 },
        "signedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
