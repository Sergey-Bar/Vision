{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.aicaptain.dev/security/v1/ai-observations/door-forced.schema.json",
  "title": "AI observation output: door forced or left open",
  "description": "Shadow-evaluation profile. Produces evaluation data only; it has no effect on authoritative state in M1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "insufficientEvidence", "doorState", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "const": "door-forced" },
    "insufficientEvidence": { "type": "boolean" },
    "doorState": { "enum": ["unknown", "closed", "open", "forced", "ajar"] },
    "personPresent": { "type": "boolean" },
    "obstruction": { "enum": ["none", "unknown", "object", "body"] },
    "openDurationSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
    "summary": { "type": "string", "maxLength": 1000 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
