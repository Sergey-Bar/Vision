{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.aicaptain.dev/security/v1/ai-observations/vehicle-at-gate.schema.json",
  "title": "AI observation output: vehicle at gate",
  "description": "Shadow-evaluation profile. Produces evaluation data only; it has no effect on authoritative state in M1. M1 has no vehicle identity resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "insufficientEvidence", "vehicleState", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "const": "vehicle-at-gate" },
    "insufficientEvidence": { "type": "boolean" },
    "vehicleState": { "enum": ["unknown", "absent", "approaching", "at_gate", "departing"] },
    "vehicleCount": { "type": "integer", "minimum": 0, "maximum": 64 },
    "plateLegible": { "type": "boolean" },
    "plateText": {
      "type": ["string", "null"],
      "maxLength": 16,
      "description": "Reported plate string as observed. Not normalized, not resolved to a vehicle identity in M1."
    },
    "gateState": { "enum": ["unknown", "closed", "open", "closing", "opening"] },
    "summary": { "type": "string", "maxLength": 1000 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
