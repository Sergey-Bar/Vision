{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.aicaptain.dev/security/v1/site-config.schema.json",
  "title": "Site configuration",
  "description": "Static, non-secret site configuration. Secrets are never present in config files; they live in the product-managed encrypted key store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "site", "paths", "database", "evidence", "observability", "ai"],
  "properties": {
    "version": { "const": 1 },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteId", "tenantId", "name", "timezones"],
      "properties": {
        "siteId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "timezones": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "defaultLocale": { "enum": ["he", "en"], "default": "he" },
        "siteTags": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 64 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "evidence", "logs", "secrets", "checkpoints"],
      "description": "All paths are absolute and resolved at install time. Program, data, config, evidence and logs are separate directories with separate permissions.",
      "properties": {
        "program": { "type": "string" },
        "data": { "type": "string" },
        "evidence": { "type": "string" },
        "logs": { "type": "string" },
        "secrets": { "type": "string" },
        "checkpoints": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["managed", "external"] },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string" },
        "sslMode": { "enum": ["disable", "require", "verify-full"], "default": "require" },
        "maxOpenConns": { "type": "integer", "minimum": 1, "maximum": 512, "default": 32 },
        "maxIdleConns": { "type": "integer", "minimum": 0, "maximum": 512, "default": 8 },
        "connMaxLifetimeSeconds": { "type": "integer", "minimum": 30, "default": 1800 },
        "statementTimeoutMs": { "type": "integer", "minimum": 0, "default": 15000 },
        "diskWarnFreePercent": { "type": "integer", "minimum": 1, "maximum": 99, "default": 30 },
        "diskCriticalFreePercent": { "type": "integer", "minimum": 1, "maximum": 99, "default": 15 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "root"],
      "properties": {
        "backend": { "const": "filesystem" },
        "root": { "type": "string", "minLength": 1 },
        "hashAlgorithm": { "const": "sha256" },
        "defaultRetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650, "default": 90 },
        "diskWarnFreePercent": { "type": "integer", "minimum": 1, "maximum": 99, "default": 25 },
        "diskCriticalFreePercent": { "type": "integer", "minimum": 1, "maximum": 99, "default": 10 }
      }
    },
    "integrations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["integrationId", "type", "enabled"],
        "properties": {
          "integrationId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "type": { "enum": ["xprotect_milestone", "xprotect_mip", "replay_fixture"] },
          "enabled": { "type": "boolean" },
          "baseUrl": { "type": "string" },
          "pollIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 5 },
          "replayRateMultiplier": { "type": "number", "minimum": 0, "exclusiveMaximum": 1000, "default": 1 },
          "fixturePath": { "type": "string" },
          "secretRef": {
            "type": "string",
            "description": "Key into the encrypted secret store. Never the secret itself."
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "description": "The AI plane is never on the availability or boot critical path. runtime disabled is a fully supported production configuration.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "runtimeUrl": { "type": "string" },
        "requestTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120, "default": 10 },
        "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 },
        "secretRef": { "type": "string" }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listenAddress": { "type": "string", "default": "127.0.0.1:8443" },
        "tlsCertRef": { "type": "string" },
        "tlsKeyRef": { "type": "string" },
        "sessionIdleMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 15 },
        "sessionAbsoluteHours": { "type": "integer", "minimum": 1, "maximum": 720, "default": 12 },
        "loginRateLimitPerMinute": { "type": "integer", "minimum": 1, "maximum": 600, "default": 5 }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logFormat": { "enum": ["json", "console"], "default": "json" },
        "logLevel": { "enum": ["debug", "info", "warn", "error"], "default": "info" },
        "logFileEnabled": { "type": "boolean", "default": true },
        "logRotateMaxMB": { "type": "integer", "minimum": 1, "default": 100 },
        "logRetainDays": { "type": "integer", "minimum": 1, "default": 30 },
        "metricsListenAddress": { "type": "string", "default": "127.0.0.1:9109" },
        "checkpointIntervalMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 60 }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseSeconds": { "type": "integer", "minimum": 5, "maximum": 3600, "default": 60 },
        "backoffBaseSeconds": { "type": "integer", "minimum": 1, "default": 5 },
        "backoffMaxSeconds": { "type": "integer", "minimum": 1, "default": 900 },
        "backpressureSoftLimit": { "type": "integer", "minimum": 1, "default": 5000 },
        "backpressureHardLimit": { "type": "integer", "minimum": 1, "default": 50000 }
      }
    }
  }
}
