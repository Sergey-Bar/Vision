# Sanitized, reviewed fixtures only. See docs/fixtures.md.
/fixtures/private/
/testdata/private/

# Tooling
/tools/bin/
/.protoc/
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/
*.swp
.DS_Store
